{
  "expo": {
    "name": "StudFlow",
    "slug": "studflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "studflow",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.studflow",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Damit du Bilder für dein Profil hochladen kannst.",
        "NSPhotoLibraryUsageDescription": "Damit du Profilbilder auswählen kannst.",
        "NSLocalNetworkUsageDescription": "StudFlow verbindet sich während der Entwicklung mit dem lokalen Expo-Server.",
        "NSBonjourServices": [
          "_http._tcp"
        ]
      }
    },
    "android": {
      "package": "com.studflow",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "themeColor": "#0B1120"
    },
    "plugins": [
      "expo-font",
      [
        "expo-notifications",
        {
          "color": "#7C6CFF"
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "8207a86d-2af4-41f4-a8c4-fb893fa3af66"
      }
    }
  }
}
