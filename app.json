{
  "expo": {
    "name": "StudFlow",
    "slug": "studflow",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "studflow",
    "icon": "./assets/icon.png",
    "splash": {
      "backgroundColor": "#FFFFFF"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.study2buddy.studflow",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Damit du Bilder für dein Profil hochladen kannst.",
        "NSPhotoLibraryUsageDescription": "Damit du Profilbilder auswählen kannst."
      }
    },
    "android": {
      "package": "com.study2buddy.studflow",
      "versionCode": 1,
      "permissions": [
        "INTERNET",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE"
      ]
    },
    "web": {
      "bundler": "metro",
      "favicon": "./assets/favicon.png",
      "themeColor": "#0B1120"
    },
    "plugins": [
      "expo-font"
    ]
  }
}
